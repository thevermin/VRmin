+// Creates Granite's device with a global priority chained onto each of its queues, retrying at the
+// default priority when the driver refuses.
+struct PriorityDeviceFactory : DeviceFactory
+{
+	int requested = 0;
+	int granted = 0;
+
+	VkDevice create_device(VkPhysicalDevice gpu, const VkDeviceCreateInfo *info) override
+	{
+		VkDevice device = VK_NULL_HANDLE;
+		const char *ext_name = nullptr;
+		if (requested > 0)
+		{
+			uint32_t count = 0;
+			vkEnumerateDeviceExtensionProperties(gpu, nullptr, &count, nullptr);
+			std::vector<VkExtensionProperties> props(count);
+			vkEnumerateDeviceExtensionProperties(gpu, nullptr, &count, props.data());
+			for (auto &prop : props)
+			{
+				if (strcmp(prop.extensionName, VK_KHR_GLOBAL_PRIORITY_EXTENSION_NAME) == 0)
+					ext_name = VK_KHR_GLOBAL_PRIORITY_EXTENSION_NAME;
+				else if (!ext_name && strcmp(prop.extensionName, VK_EXT_GLOBAL_PRIORITY_EXTENSION_NAME) == 0)
+					ext_name = VK_EXT_GLOBAL_PRIORITY_EXTENSION_NAME;
+			}
+		}
+
+		if (ext_name)
+		{
+			std::vector<const char *> exts(info->ppEnabledExtensionNames,
+			                               info->ppEnabledExtensionNames + info->enabledExtensionCount);
+			bool present = false;
+			for (auto *e : exts)
+				present = present || strcmp(e, ext_name) == 0;
+			if (!present)
+				exts.push_back(ext_name);
+
+			std::vector<VkDeviceQueueCreateInfo> queues(info->pQueueCreateInfos,
