+bool Decoder::set_haar32(int mode)
+{
+	// Mode 7 is mode 5 for 4:4:4 (Decoder V2's layout) and mode 8 is mode 6 for 4:4:4; 4:4:4 has no
+	// half-resolution dual or paired chroma (4-6).
+	if (mode < 0 || mode > 8 || (mode && !impl->can_haar32(mode >= 2)))
+		return false;
+	if (impl->chroma444() ? mode >= 4 && mode <= 6 : mode >= 7)
+		return false;
+	if (mode >= 5 && (impl->width % 4 || impl->height % 4))
+		return false;
+	if (mode >= 2 && !impl->allocate_packed())
+		return false;
+	impl->haar32 = mode != 0;
+	impl->quad_packed = mode >= 2;
+	// Levels 0-3 (PYROWAVE_HAAR32_PACKED_LEVELS=2 restores the levels 0-1 layout for A/B).
+	impl->packed_levels = getenv("PYROWAVE_HAAR32_PACKED_LEVELS") ? atoi(getenv("PYROWAVE_HAAR32_PACKED_LEVELS")) : 4;
+	impl->packed_luma_output = mode >= 3;
+	impl->dual_chroma_output = (mode >= 4 && mode <= 6) || mode == 8;
+	impl->present_output = mode >= 5;
+	impl->chroma_pairs_output = mode == 6 || mode == 8;
+	impl->present_444_output = mode >= 7;
+	return true;
+}
+
+bool Decoder::set_cdf53v2(int mode)
+{
+	// Mode 7 is mode 5 for 4:4:4: three quad-packed planes in one RGBA8 image.
+	if (mode < 0 || mode > 8 || (mode && !impl->can_cdf53v2((mode >= 4 && mode <= 6) || mode == 8)))
+		return false;
+	if (mode == 7 && !impl->chroma444())
+		return false;
+    if (mode == 8 && !impl->init_fused_rgba()) return false;
+	if (mode >= 5 && (impl->width % 4 || impl->height % 4))
+		return false;
+	if (mode >= 3 && (Configuration::get().get_precision() != 1 || !impl->allocate_packed()))
+		return false;
+	impl->cdf53v2 = mode != 0;
+    impl->fused_rgba_output = mode == 8;
+	impl->quad_packed = mode >= 3;
+	// PYROWAVE_V2_PACKED_LEVELS=2 restores the haar32 layout (A/B only).
+	impl->packed_levels = getenv("PYROWAVE_V2_PACKED_LEVELS") ? atoi(getenv("PYROWAVE_V2_PACKED_LEVELS")) : 4;
+	impl->packed_luma_output = mode >= 2 && mode != 8;
+	impl->dual_chroma_output = (mode >= 4 && mode <= 6) || mode == 8;
+	impl->present_output = mode >= 5 && mode != 8;
+	impl->chroma_pairs_output = mode == 6;
+	impl->present_444_output = mode == 7;
+	return true;
+}
+
+bool Decoder::set_fragment_rgba(bool enabled)
+{
+    if(enabled && (!impl->fragment_path || impl->legall53 || impl->haar ||
+       impl->chroma444() || Configuration::get().get_precision()!=1 ||
+       (impl->width&3) || (impl->height&3) || !impl->init_fragment_rgba()))return false;
+    impl->fragment_rgba=enabled;
+    return true;
+}
+
+bool Decoder::requires_output_sampling() const
+{
+    return impl->fused_rgba_output || impl->fragment_rgba;
+}
