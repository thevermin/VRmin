+        return mmap_abort_alloc(g, off, length, &saved, &fresh, -LINUX_ENOMEM);
+    if (mmap_extend_fresh(g, off, length, prot) < 0)
+        return mmap_abort_alloc(g, off, length, &saved, &fresh, -LINUX_ENOMEM);
+    if (!thread_quiesce_siblings())
