@@ -21,6 +21,7 @@
 #include <sys/msg.h>
 #include <sys/sem.h>
 #include <sys/shm.h>
+#include <time.h>
 
 #include "utils.h"
 
@@ -523,7 +524,35 @@ static int64_t sysv_poll_errno(bool waited)
     return (waited && errno == EINVAL) ? -LINUX_EIDRM : linux_errno();
 }
 
+/* semop and semtimedop: deadline_ns is a CLOCK_MONOTONIC time to give up with EAGAIN at, or 0 for none */
+static int64_t semop_until(guest_t *g, int semid, uint64_t sops_gva, unsigned nsops, uint64_t deadline_ns);
+
 int64_t sys_semop(guest_t *g, int semid, uint64_t sops_gva, unsigned nsops)
+{
+    return semop_until(g, semid, sops_gva, nsops, 0);
+}
+
+static uint64_t mono_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t) ts.tv_sec * 1000000000ull + (uint64_t) ts.tv_nsec;
+}
+
+int64_t sys_semtimedop(guest_t *g, int semid, uint64_t sops_gva, unsigned nsops, uint64_t timeout_gva)
+{
+    if (!timeout_gva)
+        return semop_until(g, semid, sops_gva, nsops, 0);
+    struct { int64_t sec, nsec; } t;
+    if (guest_read(g, timeout_gva, &t, sizeof t) < 0)
+        return -LINUX_EFAULT;
+    if (t.sec < 0 || t.nsec < 0 || t.nsec >= 1000000000)
+        return -LINUX_EINVAL;
+    uint64_t deadline = mono_ns() + (uint64_t) t.sec * 1000000000ull + (uint64_t) t.nsec;
+    return semop_until(g, semid, sops_gva, nsops, deadline ? deadline : 1);
+}
+
+static int64_t semop_until(guest_t *g, int semid, uint64_t sops_gva, unsigned nsops, uint64_t deadline_ns)
 {
     if (nsops == 0 || nsops > 256)
         return -LINUX_EINVAL;
@@ -597,6 +626,11 @@ int64_t sys_semop(guest_t *g, int semid, uint64_t sops_gva, unsigned nsops)
                 break;
             }
         }
+        /* semtimedop: its time is up (Linux says EAGAIN) */
+        if (deadline_ns && mono_ns() >= deadline_ns) {
+            rc = -LINUX_EAGAIN;
+            break;
+        }
         rc = io_retry_backoff(&backoff);
         if (rc < 0)
             break;
