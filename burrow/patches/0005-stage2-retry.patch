+/* Whether an IPA is in an HVF segment now. A sibling vCPU that took a stage-2
+ * abort while a segment split had its IPA unmapped retries when it is (see
+ * stage2_retry in proc.c). Call with mmap_lock held.
+ */
+bool hvf_ipa_mapped(const guest_t *g, uint64_t ipa)
+{
+    return hvf_segment_find(g, ipa) >= 0;
+}
