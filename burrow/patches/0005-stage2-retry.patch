 /* Restore the slab backing for [ipa, ipa+len) in the host VA. Used to undo a
  * previous file overlay. Maps shm_fd MAP_SHARED if the slab is shm-backed (so
  * subsequent fork CoW snapshots see consistent content), otherwise
diff --git a/src/syscall/proc.c b/src/syscall/proc.c
index 19ae8d3..799765b 100644
--- a/src/syscall/proc.c
+++ b/src/syscall/proc.c
@@ -4223,6 +4223,31 @@ static bool syscall_return_epilogue(guest_t *g,
     return running;
 }
 
+/* A stage-2 abort (EC 0x20 or 0x24 reaching EL2) on an IPA that is mapped
+ * again: a sibling vCPU split the HVF segment holding it (hv_vm_unmap of the
+ * whole segment, then hv_vm_map of the pieces) while this one ran, and for that
+ * moment everything in the segment, the shim and the page tables included, was
+ * gone. Waiting on mmap_lock lets the split finish; then the instruction runs
+ * again. Bounded per IPA, so a real hole still ends in the crash report.
+ */
+static bool stage2_retry(guest_t *g, uint64_t ipa)
+{
+    static _Thread_local uint64_t last_ipa;
+    static _Thread_local int tries;
+    mmap_lock_acquire();
+    bool mapped = hvf_ipa_mapped(g, ipa);
+    mmap_lock_release();
+    if (ipa != last_ipa) {
+        last_ipa = ipa;
+        tries = 0;
+    }
+    if (mapped && tries < 64) {
+        tries++;
+        return true;
+    }
+    return false;
+}
