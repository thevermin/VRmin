 _CreateMetalViewFromHWND(void *obj) {
   struct unixcall_create_metal_view_from_hwnd *params = obj;
+  HWND hwnd = (HWND)(uintptr_t)params->hwnd;
+  macdrv_metal_device device = (macdrv_metal_device)params->device;
