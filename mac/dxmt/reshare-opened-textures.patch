   Com<DeviceTexture<tag>> device_texture = (ref(new DeviceTexture<tag>(&finalDesc, std::move(texture), pDevice)));
+  HANDLE nt = nullptr;
+  if (NtHandle)
+    DuplicateHandle(GetCurrentProcess(), NtHandle, GetCurrentProcess(), &nt, 0, FALSE, DUPLICATE_SAME_ACCESS);
+  device_texture->SetImportedHandles(GlobalHandle, nt);
   return device_texture->QueryInterface(riid, ppTexture);
 }
 
