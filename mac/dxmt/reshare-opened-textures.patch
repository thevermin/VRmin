+    global_kmt_ = globalHandle;
+    imported_nt_ = ntHandle;
+  }
+
   ~DeviceTexture() {
+    if (imported_nt_)
+      CloseHandle(imported_nt_);
     if (local_kmt_) {
       D3DKMT_DESTROYALLOCATION destroy = {};
       destroy.hDevice = this->m_parent->GetLocalD3DKMT();
@@ -278,6 +288,12 @@ public:
   CreateSharedHandle(const SECURITY_ATTRIBUTES *Attributes, DWORD Access, const WCHAR *pName, HANDLE *pNTHandle)
       override {
     InitReturnPtr(pNTHandle);
+    if (!local_kmt_ && imported_nt_ && !pName) {
+      if (!DuplicateHandle(GetCurrentProcess(), imported_nt_, GetCurrentProcess(), pNTHandle, 0, FALSE,
+                           DUPLICATE_SAME_ACCESS))
+        return E_FAIL;
+      return S_OK;
+    }
     if (!local_kmt_)
       return E_INVALIDARG;
 
@@ -471,7 +487,7 @@ template <typename tag>
 HRESULT
 ImportSharedTextureInternal(
