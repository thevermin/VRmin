   float min_lod = 0.0;
   D3DKMT_HANDLE local_kmt_ = 0;
   D3DKMT_HANDLE global_kmt_ = 0;
+  // An opened shared texture can be shared again, as in Windows: the handle it was opened with (SteamVR passes
+  // textures other programs shared with it on to its compositor)
+  HANDLE imported_nt_ = nullptr;
 
   using SRVBase =
       TResourceViewBase<tag_shader_resource_view<DeviceTexture<tag_texture>>>;
@@ -126,7 +129,14 @@ public:
         this->texture_ = std::move(u_texture);
