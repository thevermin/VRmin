 public:
+  /* A buffer created D3D11_RESOURCE_MISC_SHARED gets a handle so that creating
+   * it succeeds where the caller requires one (SteamVR's compositor shares its
+   * frame info constant buffer this way), but it is not opened in other
+   * processes: OpenSharedResource only imports textures.
+   */
+  HRESULT
+  GetSharedHandle(HANDLE *pSharedHandle) override {
+    if (!pSharedHandle || !(this->desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED))
+      return E_INVALIDARG;
+    *pSharedHandle = reinterpret_cast<HANDLE>((reinterpret_cast<uintptr_t>(this) >> 4) << 2 | 0x40000000);
+    return S_OK;
+  }
