 namespace dxmt {
 
+/* IDXGIKeyedMutex for resources created SHARED or SHARED_KEYEDMUTEX. The
+ * acquire and release don't wait: within one Metal device the GPU work of
+ * the processes sharing the resource isn't reordered by the key. Without the
+ * interface, SteamVR's compositor (which takes the mutex of every texture it
+ * shares with games and drivers) draws nothing usable.
+ */
+class MTLDXGIKeyedMutex final : public IDXGIKeyedMutex {
+  std::atomic<ULONG> refs_{1};
+  ID3D11Resource *resource_;
+
+public:
+  MTLDXGIKeyedMutex(ID3D11Resource *resource) : resource_(resource) { resource_->AddRef(); }
+  ~MTLDXGIKeyedMutex() { resource_->Release(); }
+
+  HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void **ppvObject) override {
+    if (!ppvObject)
+      return E_POINTER;
+    if (riid == __uuidof(IUnknown) || riid == __uuidof(IDXGIObject) || riid == __uuidof(IDXGIDeviceSubObject) ||
+        riid == __uuidof(IDXGIKeyedMutex)) {
+      AddRef();
+      *ppvObject = this;
+      return S_OK;
+    }
+    return resource_->QueryInterface(riid, ppvObject);
+  }
+  ULONG STDMETHODCALLTYPE AddRef() override { return ++refs_; }
+  ULONG STDMETHODCALLTYPE Release() override {
+    ULONG r = --refs_;
+    if (!r)
+      delete this;
+    return r;
+  }
+  HRESULT STDMETHODCALLTYPE SetPrivateData(REFGUID Name, UINT DataSize, const void *pData) override {
+    return resource_->SetPrivateData(Name, DataSize, pData);
+  }
+  HRESULT STDMETHODCALLTYPE SetPrivateDataInterface(REFGUID Name, const IUnknown *pUnknown) override {
+    return resource_->SetPrivateDataInterface(Name, pUnknown);
+  }
+  HRESULT STDMETHODCALLTYPE GetPrivateData(REFGUID Name, UINT *pDataSize, void *pData) override {
+    return resource_->GetPrivateData(Name, pDataSize, pData);
+  }
+  HRESULT STDMETHODCALLTYPE GetParent(REFIID riid, void **ppParent) override {
+    IDXGIResource *r = nullptr;
+    if (FAILED(resource_->QueryInterface(__uuidof(IDXGIResource), (void **)&r)))
+      return E_NOINTERFACE;
+    HRESULT hr = r->GetParent(riid, ppParent);
+    r->Release();
+    return hr;
+  }
+  HRESULT STDMETHODCALLTYPE GetDevice(REFIID riid, void **ppDevice) override {
+    ID3D11Device *d = nullptr;
+    resource_->GetDevice(&d);
+    if (!d)
+      return E_FAIL;
+    HRESULT hr = d->QueryInterface(riid, ppDevice);
+    d->Release();
+    return hr;
+  }
+  HRESULT STDMETHODCALLTYPE AcquireSync(UINT64 Key, DWORD dwMilliseconds) override { return S_OK; }
+  HRESULT STDMETHODCALLTYPE ReleaseSync(UINT64 Key) override { return S_OK; }
+};
+
