       descriptor.resourceOptions = MTLResourceStorageModePrivate |
                                    MTLResourceHazardTrackingModeUntracked;
+#if __MAC_OS_X_VERSION_MAX_ALLOWED >= 260400
       descriptor.placementSparsePageSize = MTLSparsePageSize64;
       return [dev newTextureWithDescriptor:descriptor];
+#else
+      return NULL;   /* (never: sparse isn't advertised without the macOS 26.4 SDK) */
+#endif
    }
 }
 
@@ -376,10 +382,14 @@ mtl_new_placement_sparse_buffer(mtl_device *device, uint64_t size_B)
