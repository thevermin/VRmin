diff --git a/OpenOVR/Misc/vrmin.h b/OpenOVR/Misc/vrmin.h
new file mode 100644
index 0000000..dfe58f8
--- /dev/null
+++ b/OpenOVR/Misc/vrmin.h
@@ -0,0 +1,148 @@
+#pragma once
+// VRmin: direct links between OpenComposite and VRmin's OpenXR runtime (questvrbridge_openxr.dll), plus per-frame
+// timing statistics written to VRmin's log. Everything here is optional: with another OpenXR runtime the functions
+// aren't found and OpenComposite behaves as upstream.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <openxr/openxr.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace vrmin {
+
+typedef int(__cdecl* ImageSourceFn)(XrSwapchain swapchain, void* texture, uint32_t subresource, uint32_t x, uint32_t y, uint32_t w, uint32_t h);
+typedef void(__cdecl* LogFn)(const char* message);
+
+struct Runtime {
+	ImageSourceFn imageSource = nullptr;
+	LogFn log = nullptr;
+	bool looked = false;
+};
+
+inline Runtime& GetRuntime()
+{
+	static Runtime rt;
+	if (!rt.looked) {
+		rt.looked = true;
+#ifdef _WIN32
+		HMODULE m = GetModuleHandleA("questvrbridge_openxr.dll");
+		if (!m)
+			m = GetModuleHandleA("questvrbridge_openxr32.dll");
+		if (m) {
+			rt.imageSource = (ImageSourceFn)GetProcAddress(m, "vrmin_image_source");
+			rt.log = (LogFn)GetProcAddress(m, "vrmin_log");
+		}
+#endif
+	}
+	return rt;
+}
+
+// Lets the runtime read the image straight from the game's texture (the image the swapchain image was just acquired
+// for), so it doesn't have to be copied into the swapchain first. Returns false if the runtime can't (then copy).
+inline bool ImageSource(XrSwapchain swapchain, void* texture, uint32_t subresource, uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+	Runtime& rt = GetRuntime();
+	return rt.imageSource && rt.imageSource(swapchain, texture, subresource, x, y, w, h) != 0;
+}
+
+// The runtime reads the eye images when the frame ends, after both eyes are submitted. That's only safe if the game
+// doesn't draw the second eye into the same image it handed over for the first one: the left eye goes direct only if,
+// in the previous frame, the right eye came from a different texture or region. (The right eye is always safe.)
+inline bool EyeCanBeDirect(int eye, void* texture, uint32_t subresource, uint32_t left)
+{
+	struct Last {
+		void* tex = nullptr;
+		uint32_t sub = 0, left = 0;
+	};
+	static Last last[2];
+	bool ok = eye != 0 || (last[1].tex && (last[1].tex != texture || last[1].sub != subresource || last[1].left != left));
+	if (eye == 0 || eye == 1)
+		last[eye] = { texture, subresource, left };
+	return ok;
+}
+
+// The swapchain image was filled by a copy: the runtime must use it (not an earlier game texture).
+inline void ClearImageSource(XrSwapchain swapchain)
+{
+	Runtime& rt = GetRuntime();
+	if (rt.imageSource)
+		rt.imageSource(swapchain, nullptr, 0, 0, 0, 0, 0);
+}
+
+// ---- Timing statistics ----
+
+enum Stat {
+	STAT_SUBMIT, // Submit (handing over each eye's image)
+	STAT_WAIT, // WaitGetPoses (xrWaitFrame + xrBeginFrame)
+	STAT_END, // xrEndFrame
+	STAT_INPUT, // input calls (actions and legacy controller state)
+	STAT_OVERLAY, // SetOverlayTexture
+	STAT_COUNT
+};
+
+struct Stats {
+	std::atomic<int64_t> us[STAT_COUNT]{};
+	std::atomic<int64_t> calls[STAT_COUNT]{};
+	std::atomic<int64_t> frames{ 0 };
+	std::atomic<int64_t> directEyes{ 0 }, copiedEyes{ 0 };
+	std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+};
+
+inline Stats& GetStats()
+{
+	static Stats s;
+	return s;
+}
+
+struct Timer {
+	Stat stat;
+	std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+	explicit Timer(Stat s)
+	    : stat(s)
+	{
+	}
+	~Timer()
+	{
+		Stats& s = GetStats();
+		s.us[stat] += std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+		s.calls[stat]++;
+	}
+};
+
+// Called once per frame (after xrEndFrame): every 5 seconds, writes the averages per frame to VRmin's log
+inline void OnFrame()
+{
+	Stats& s = GetStats();
+	int64_t frames = ++s.frames;
+	auto now = std::chrono::steady_clock::now();
+	double secs = std::chrono::duration<double>(now - s.start).count();
+	if (secs < 5.0)
+		return;
+	Runtime& rt = GetRuntime();
+	if (rt.log && frames > 0) {
+		auto ms = [&](Stat k) { return s.us[k].load() / 1000.0 / frames; };
+		auto per = [&](Stat k) { return (double)s.calls[k].load() / frames; };
+		char line[512];
+		snprintf(line, sizeof line,
+		    "OpenComposite: %.0f cuadros/s \xc2""\xb7"" por cuadro: entregar im\xc3""\xa1""genes %.2f ms, esperar turno %.2f ms, cerrar cuadro %.2f ms (dentro de entregar), "
+		    "controles %.2f ms (%.0f llamadas), paneles %.2f ms (%.1f actualizaciones) \xc2""\xb7"" ojos sin copia %lld, con copia %lld",
+		    frames / secs, ms(STAT_SUBMIT), ms(STAT_WAIT), ms(STAT_END), ms(STAT_INPUT), per(STAT_INPUT), ms(STAT_OVERLAY), per(STAT_OVERLAY),
+		    (long long)s.directEyes.load(), (long long)s.copiedEyes.load());
+		rt.log(line);
+	}
+	for (int k = 0; k < STAT_COUNT; k++) {
+		s.us[k] = 0;
+		s.calls[k] = 0;
+	}
+	s.frames = 0;
+	s.directEyes = 0;
+	s.copiedEyes = 0;
+	s.start = now;
+}
+
+} // namespace vrmin
