+ * a mach port registered with launchd under a name it keeps in the resource's runtime data; MoltenVK takes the
+ * texture itself (VK_EXT_external_memory_metal). This is how a Vulkan game hands its images to SteamVR, whose
+ * compositor uses D3D11. Returns a retained id<MTLTexture>, or NULL. */
+static void *import_metal_texture( D3DKMT_HANDLE global, HANDLE shared )
+{
+    static void *(*msg)(void);
+    static void *(*get_class)( const char * );
+    static void *(*sel)( const char * );
+    static void *device;
+    char runtime[256] = {0};
+    mach_port_t port = MACH_PORT_NULL;
+    void *handle, *texture = NULL;
+    UINT size;
+
+    if (!msg)
