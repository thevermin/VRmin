+/* VRmin: the private runtime data of a D3DKMT global or shared resource, as the driver that created it stored it
+ * (DXMT keeps the name of its Metal texture there). Returns its size, 0 if it can't be read. */
+UINT d3dkmt_get_resource_runtime( D3DKMT_HANDLE global, HANDLE shared, void *data, UINT size )
+{
+    struct d3dkmt_resource *resource = NULL;
+    UINT runtime_size = 0;
+    void *buffer;
+
+    if (d3dkmt_object_query( D3DKMT_RESOURCE, global, shared, &runtime_size ) || !runtime_size) return 0;
+    if (!(buffer = malloc( runtime_size ))) return 0;
+    if (d3dkmt_object_alloc( sizeof(*resource), D3DKMT_RESOURCE, (void **)&resource )) runtime_size = 0;
+    else
+    {
+        if (d3dkmt_object_open( &resource->obj, global, shared, buffer, &runtime_size )) runtime_size = 0;
+        d3dkmt_object_free( &resource->obj );
+    }
+    if (runtime_size) memcpy( data, buffer, min( size, runtime_size ) );
+    free( buffer );
+    return runtime_size;
+}
