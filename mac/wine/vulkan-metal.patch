+        void *objc = dlopen( "/usr/lib/libobjc.A.dylib", RTLD_NOW );
+        void *metal = dlopen( "/System/Library/Frameworks/Metal.framework/Metal", RTLD_NOW );
+        void *(*create_device)(void) = metal ? dlsym( metal, "MTLCreateSystemDefaultDevice" ) : NULL;
+        if (!objc || !create_device) return NULL;
+        get_class = dlsym( objc, "objc_getClass" );
+        sel = dlsym( objc, "sel_registerName" );
+        if (!get_class || !sel || !(device = create_device())) return NULL;
+        msg = dlsym( objc, "objc_msgSend" );
+        if (!msg) return NULL;
+    }
+
+    size = d3dkmt_get_resource_runtime( global, shared, runtime, sizeof(runtime) - 1 );
+    if (size < 22 || strncmp( runtime, "DXMT_shared_resource_", 21 ))
+    {
+        FIXME( "Shared resource %#x/%p isn't a DXMT texture (runtime data size %#x)\n", global, shared, size );
+        return NULL;
+    }
+    runtime[53] = 0;
+    if (bootstrap_look_up( bootstrap_port, runtime, &port ) != KERN_SUCCESS || !port)
+    {
+        WARN( "No mach port named %s\n", debugstr_a(runtime) );
+        return NULL;
+    }
+    handle = ((void *(*)(void *, void *))msg)( get_class( "MTLSharedTextureHandle" ), sel( "alloc" ) );
+    if (handle) handle = ((void *(*)(void *, void *, mach_port_t))msg)( handle, sel( "initWithMachPort:" ), port );
+    if (handle)
+    {
+        texture = ((void *(*)(void *, void *, void *))msg)( device, sel( "newSharedTextureWithHandle:" ), handle );
+        ((void (*)(void *, void *))msg)( handle, sel( "release" ) );
+    }
+    if (texture)
+        WARN( "VRmin: DXMT texture %s -> %p, %lux%lu, Metal format %lu\n", debugstr_a(runtime), texture,
+              (unsigned long)((uintptr_t (*)(void *, void *))msg)( texture, sel( "width" ) ),
+              (unsigned long)((uintptr_t (*)(void *, void *))msg)( texture, sel( "height" ) ),
+              (unsigned long)((uintptr_t (*)(void *, void *))msg)( texture, sel( "pixelFormat" ) ) );
+    else WARN( "VRmin: DXMT texture %s: Metal couldn't open it\n", debugstr_a(runtime) );
+    return texture;
+}
+
+static void release_metal_texture( void *texture )
+{
+    void *objc = texture ? dlopen( "/usr/lib/libobjc.A.dylib", RTLD_NOW | RTLD_NOLOAD ) : NULL;
+    void *(*sel)( const char * ) = objc ? dlsym( objc, "sel_registerName" ) : NULL;
+    void (*msg)(void *, void *) = objc ? dlsym( objc, "objc_msgSend" ) : NULL;
+    if (sel && msg) msg( texture, sel( "release" ) );
+}
+#else
+static void *import_metal_texture( D3DKMT_HANDLE global, HANDLE shared ) { return NULL; }
+static void release_metal_texture( void *texture ) {}
+#endif
